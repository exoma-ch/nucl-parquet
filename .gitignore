# Python
__pycache__/
*.pyc
.venv/

# Build artifacts
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.egg-info/
dist/
build/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Generated artifacts (rebuild with scripts/)
plots/

# Upstream data caches — fetched on demand by scripts/fetch_*.py
data/g4_raw/

# docs/ is generated, but theranostics source files and ADRs are tracked
docs/*
!docs/theranostics/
docs/theranostics/*
!docs/theranostics/generate.py
!docs/theranostics/refs.bib
!docs/theranostics/.gitignore
!docs/adr/
!docs/adr/*.md
!docs/g4-xray-auger-design.md

# nucl-parquet-mcp is a binary that path-depends on the sibling nucl-parquet
# crate. Committing its lockfile means every nucl-parquet version bump leaves
# this lock stale until cargo relocks it, which trips the pre-commit clippy
# hook and blocks release PRs (release-please cannot cross-update a sibling
# crate lock outside a workspace). cargo regenerates it at build/publish.
clients/rs/nucl-parquet-mcp/Cargo.lock
