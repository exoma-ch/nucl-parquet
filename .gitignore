# Python
__pycache__/
*.pyc
.venv/

# Build artifacts
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.egg-info/
dist/
build/

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Generated artifacts (rebuild with scripts/)
plots/

# Upstream data caches — fetched on demand by scripts/fetch_*.py
data/g4_raw/

# docs/ is generated, but theranostics source files and ADRs are tracked
docs/*
!docs/theranostics/
docs/theranostics/*
!docs/theranostics/generate.py
!docs/theranostics/refs.bib
!docs/theranostics/.gitignore
!docs/adr/
!docs/adr/*.md
!docs/g4-xray-auger-design.md
# Data-release signing (#289). Allowlisted by name, not as `!docs/security/*`,
# so a secret key accidentally written into this directory stays ignored and
# cannot be committed by a stray `git add`.
!docs/security/
!docs/security/data-signing.md
!docs/security/data-signing-key.pub

# Minisign secret key material must never be committed. The public key is
# allowlisted above by name; everything else stays out.
*.key
*.sec
.direnv/
.claude/
